{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/access", "destination": "/index.html" },
    { "source": "/access/", "destination": "/index.html" },
    { "source": "/access/:match*", "destination": "/index.html" }
  ]
}
